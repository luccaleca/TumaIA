# Copie para backend/.env e preencha os valores.

PORT=4000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

INTERNAL_WEBHOOK_SECRET=

# WhatsApp direto (WPPConnect Server → POST /wppconnect/webhook) — lab local
# WPPCONNECT_ENABLED=true
# WPPCONNECT_BASE_URL=http://127.0.0.1:21465
# WPPCONNECT_SESSION=tumaia
# WPPCONNECT_SECRET_KEY=mesma-chave-do-wppconnect-server
# WhatsApp: usuário precisa telefone no cadastro + workspace ativo no painel (id_empresa_ultima)

# WhatsApp Cloud API (Meta) — canal oficial (webhook Graph; sem QR)
# WHATSAPP_CLOUD_ENABLED=false
# WHATSAPP_CLOUD_ACCESS_TOKEN=   # token com whatsapp_business_messaging + whatsapp_business_management
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=  # Phone number ID do API Setup (não é o +55…)
# WHATSAPP_CLOUD_WABA_ID=          # WhatsApp Business Account ID (opcional)
# WHATSAPP_CLOUD_VERIFY_TOKEN=tumaia-wa-verify  # mesmo valor no painel Meta → Webhook
# WHATSAPP_CLOUD_APP_SECRET=       # opcional: valida X-Hub-Signature-256
# WHATSAPP_CLOUD_API_VERSION=v21.0
# WHATSAPP_CLOUD_TEST_TO=5511XXXXXXXXX  # destinatário E.164 do hello_world (sem +)
# Webhook local: HTTPS (ngrok) → POST/GET /whatsapp/cloud/webhook
# Status: GET /whatsapp/cloud/status

# Publicação Instagram direta (Meta Graph API — sem n8n)
# Conta Professional/Business + Página do Facebook + token com instagram_content_publish
# INSTAGRAM_GRAPH_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=   # IG User ID (não o @username)
# INSTAGRAM_GRAPH_API_VERSION=v21.0
# INSTAGRAM_PUBLISH_TIMEOUT_MS=120000
# Bucket midias precisa ser público para o Instagram baixar a imagem (getPublicUrl)

# Área TumaCore Plataforma (ops/analytics global) — allowlist de e-mails.
# Autorização só no backend (não confiar no frontend). Nunca liberar por domínio.
# Separados por vírgula. Lista oficial da equipe Tuma:
TUMAIA_PLATAFORMA_ADMIN_EMAILS=luccaprogramacao@gmail.com,as.frasson3@gmail.com,crepaldi.fukumura@gmail.com,dfp.piva@gmail.com,diegonavarro490@gmail.com

# === Chat (agente cloud + identidade da marca) ===
TUMAIA_NODE_CHAT=true
CHAT_LLM_PROVIDER=cloud
CHAT_CLOUD_API_KEY=
CHAT_CLOUD_MODEL=grok-4.6
# Ids válidos: grok-4.6 | composer-2.5 | default (Auto). Evite composer-2.5-fast (inválido).
# Runtime do SDK: local (padrão, sem VM) | cloud (VM hospedada; sujeita a rate limit).
CHAT_CLOUD_RUNTIME=local
# CHAT_CLOUD_LOCAL_CWD=  # opcional; padrão = pasta tmp isolada
CHAT_CLOUD_TIMEOUT_MS=300000
CHAT_CLOUD_SESSION_TTL_MS=1500000
# Demo: agente interpreta linguagem humana com .md em backend/ia/agente/ (desligar em produção se preferir).
# CHAT_DEMO_AGENT=true
# Interpretação de briefing via LLM (JSON). Provider padrão: Ollama (não cloud).
# CHAT_CREATION_LLM_INTERPRET=true
# CHAT_CREATION_LLM_PROVIDER=ollama
# CHAT_CREATION_LLM_TIMEOUT_MS=90000
# LLAMA_MODEL=qwen2.5:3b
# Live da bateria: CHAT_CREATION_LLM_INTERPRET_LIVE=true (só Ollama; sem gerar imagem).
# GET /empresas/:id/agente-marca — preview do markdown de treino da empresa.
#
# Legado (só se precisar voltar ao Ollama no chat):
# CHAT_LLM_PROVIDER=ollama
# OLLAMA_FAST_CHAT_MODEL=llama3.2:1b
# TUMAIA_NODE_CHAT=false
# TUMAIA_WHATSAPP_FAST_PATH=true

# Ollama ainda usado em fluxos opcionais (ex. análise de identidade / revisão visual), não no chat padrão.
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=qwen2.5:3b
LLAMA_PROPOSAL_MODEL=qwen2.5:3b
OLLAMA_CHAT_MODEL=qwen2.5:3b
LLAMA_API_KEY=ollama

# Worker Python do chat (opcional / legado)
# CHAT_WORKER_BOOT_TIMEOUT_MS=480000
# CHAT_WORKER_REQUEST_TIMEOUT_MS=360000

# Imagens — padrão Grok Imagine exige XAI_API_KEY (console.x.ai).
# CHAT_CLOUD_API_KEY com prefixo crsr_ é do chat cloud — NÃO autentica api.x.ai.
# GROK_ALLOW_BILLING=true
# XAI_API_KEY=
# GROK_IMAGE_MODEL=grok-imagine-image-2.0
# GROK_IMAGE_QUALITY=auto
# GROK_IMAGE_RESOLUTION=1k
# IMAGE_PROVIDER=grok

# Secundário / recomendado sem XAI_API_KEY: Replicate (openai/gpt-image-2)
# REPLICATE_API_TOKEN=
# REPLICATE_ALLOW_BILLING=true
IMAGE_PROVIDER=replicate

# Alternativa: OpenAI oficial
# OPENAI_API_KEY=
# OPENAI_ALLOW_BILLING=true
# IMAGE_PROVIDER=openai
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high

POST_CONTEXT_USE_LLAMA=false
IMAGE_PIPELINE=raw
# Produto na arte: gpt_integrated (padrão). collage / collage_refine = legado Sharp, só debug local.
IMAGE_PRODUCT_MODE=gpt_integrated
# IMAGE_PRODUCT_MODE=collage
# IMAGE_PRODUCT_MODE=collage_refine

# Revisão visual (Llava/Ollama) antes de mostrar a prévia — desligada por padrão (lenta)
# IMAGE_PREVIEW_QUALITY_REVIEW=true
# IMAGE_PREVIEW_QUALITY_MIN_SCORE=68

# Legenda/hashtags: replicate (padrão com REPLICATE_ALLOW_BILLING), ollama ou openai
# TEXT_PROVIDER=replicate
# REPLICATE_TEXT_MODEL=meta/meta-llama-3-8b-instruct
# LLAMA_VISION_MODEL=llava:7b
