# Copie para backend/.env e preencha os valores.

PORT=4000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

INTERNAL_WEBHOOK_SECRET=

# WhatsApp direto (WPPConnect Server → POST /wppconnect/webhook)
# WPPCONNECT_ENABLED=true
# WPPCONNECT_BASE_URL=http://127.0.0.1:21465
# WPPCONNECT_SESSION=tumaia
# WPPCONNECT_SECRET_KEY=mesma-chave-do-wppconnect-server
# WhatsApp: usuário precisa telefone no cadastro + workspace ativo no painel (id_empresa_ultima)

# Publicação Instagram via n8n (Production URL, não /webhook-test/)
# N8N_INSTAGRAM_WEBHOOK_URL=https://seu-n8n.ngrok-free.dev/webhook/instagram-post
# N8N_INSTAGRAM_CLIENT_ID=tumaia
# Bucket midias precisa ser público para o Instagram baixar a imagem (getPublicUrl)

# === Chat (agente cloud + identidade da marca) ===
TUMAIA_NODE_CHAT=true
CHAT_LLM_PROVIDER=cloud
CHAT_CLOUD_API_KEY=
CHAT_CLOUD_MODEL=grok-4.6
CHAT_CLOUD_TIMEOUT_MS=300000
CHAT_CLOUD_SESSION_TTL_MS=1500000
# GET /empresas/:id/agente-marca — preview do markdown de treino da empresa.
#
# Legado (só se precisar voltar ao Ollama no chat):
# CHAT_LLM_PROVIDER=ollama
# OLLAMA_FAST_CHAT_MODEL=llama3.2:1b
# TUMAIA_NODE_CHAT=false
# TUMAIA_WHATSAPP_FAST_PATH=true

# Ollama ainda usado em fluxos opcionais (ex. análise de identidade / revisão visual), não no chat padrão.
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=qwen2.5:3b
LLAMA_PROPOSAL_MODEL=qwen2.5:3b
OLLAMA_CHAT_MODEL=qwen2.5:3b
LLAMA_API_KEY=ollama

# Worker Python do chat (opcional / legado)
# CHAT_WORKER_BOOT_TIMEOUT_MS=480000
# CHAT_WORKER_REQUEST_TIMEOUT_MS=360000

# Imagens — renderizador secundário (OpenAI ou Replicate)
# OPENAI_API_KEY=
# OPENAI_ALLOW_BILLING=true
# IMAGE_PROVIDER=openai
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high

# REPLICATE_API_TOKEN=
# REPLICATE_ALLOW_BILLING=true
# IMAGE_PROVIDER=replicate

POST_CONTEXT_USE_LLAMA=false
IMAGE_PIPELINE=raw
IMAGE_PROVIDER=openai
IMAGE_PRODUCT_MODE=gpt_integrated

# Revisão visual (Llava/Ollama) antes de mostrar a prévia — desligada por padrão (lenta)
# IMAGE_PREVIEW_QUALITY_REVIEW=true
# IMAGE_PREVIEW_QUALITY_MIN_SCORE=68

# Legenda/hashtags: replicate (padrão com REPLICATE_ALLOW_BILLING), ollama ou openai
# TEXT_PROVIDER=replicate
# REPLICATE_TEXT_MODEL=meta/meta-llama-3-8b-instruct
# LLAMA_VISION_MODEL=llava:7b
